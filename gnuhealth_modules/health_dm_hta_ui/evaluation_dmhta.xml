<?xml version="1.0"?>
<tryton>
    <data>
        <!-- ==========================================================================
             Puerta 1: menú propio "Salud → DM/HTA" (lista todas las valoraciones DM/HTA).
             ========================================================================== -->
        <record model="ir.action.act_window" id="act_dmhta_valoraciones">
            <field name="name">DM/HTA</field>
            <field name="res_model">gnuhealth.patient.evaluation</field>
            <field name="domain" eval="[('dmhta_es_valoracion', '=', True)]" pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_dmhta_valoraciones_tree">
            <field name="sequence" eval="10"/>
            <field name="view" ref="evaluation_dmhta_tree_view"/>
            <field name="act_window" ref="act_dmhta_valoraciones"/>
        </record>
        <record model="ir.action.act_window.view" id="act_dmhta_valoraciones_form">
            <field name="sequence" eval="20"/>
            <field name="view" ref="evaluation_dmhta_form_view"/>
            <field name="act_window" ref="act_dmhta_valoraciones"/>
        </record>
        <menuitem action="act_dmhta_valoraciones" id="menu_dmhta_valoraciones"
            parent="health.gnuhealth_menu" sequence="45" icon="gnuhealth-list"/>

        <!-- ==========================================================================
             Puerta 2: acción relacionada desde el paciente (solo sus valoraciones DM/HTA).
             Al crear un registro nuevo desde aquí, el dominio preselecciona el paciente.
             ========================================================================== -->
        <record model="ir.action.act_window" id="act_dmhta_desde_paciente">
            <field name="name">Valoraciones DM/HTA</field>
            <field name="res_model">gnuhealth.patient.evaluation</field>
            <field name="domain"
                eval="[('patient', '=', Eval('active_id')), ('dmhta_es_valoracion', '=', True)]"
                pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_dmhta_desde_paciente_tree">
            <field name="sequence" eval="10"/>
            <field name="view" ref="evaluation_dmhta_tree_view"/>
            <field name="act_window" ref="act_dmhta_desde_paciente"/>
        </record>
        <record model="ir.action.act_window.view" id="act_dmhta_desde_paciente_form">
            <field name="sequence" eval="20"/>
            <field name="view" ref="evaluation_dmhta_form_view"/>
            <field name="act_window" ref="act_dmhta_desde_paciente"/>
        </record>
        <record model="ir.action.keyword" id="act_dmhta_desde_paciente_keyword">
            <field name="keyword">form_relate</field>
            <field name="model">gnuhealth.patient,-1</field>
            <field name="action" ref="act_dmhta_desde_paciente"/>
        </record>

        <!-- ==========================================================================
             Puerta 2-bis: acción relacionada desde la PERSONA (party.party). En GNU Health
             la ficha "Paciente" y la ficha "Persona" son modelos distintos; el médico puede
             abrir cualquiera. Aquí el id activo es el de la persona, así que filtramos por
             el paciente cuya persona (party) es la abierta.
             ========================================================================== -->
        <record model="ir.action.act_window" id="act_dmhta_desde_persona">
            <field name="name">Valoraciones DM/HTA</field>
            <field name="res_model">gnuhealth.patient.evaluation</field>
            <field name="domain"
                eval="[('patient.party', '=', Eval('active_id')), ('dmhta_es_valoracion', '=', True)]"
                pyson="1"/>
        </record>
        <record model="ir.action.act_window.view" id="act_dmhta_desde_persona_tree">
            <field name="sequence" eval="10"/>
            <field name="view" ref="evaluation_dmhta_tree_view"/>
            <field name="act_window" ref="act_dmhta_desde_persona"/>
        </record>
        <record model="ir.action.act_window.view" id="act_dmhta_desde_persona_form">
            <field name="sequence" eval="20"/>
            <field name="view" ref="evaluation_dmhta_form_view"/>
            <field name="act_window" ref="act_dmhta_desde_persona"/>
        </record>
        <record model="ir.action.keyword" id="act_dmhta_desde_persona_keyword">
            <field name="keyword">form_relate</field>
            <field name="model">party.party,-1</field>
            <field name="action" ref="act_dmhta_desde_persona"/>
        </record>
    </data>
</tryton>
