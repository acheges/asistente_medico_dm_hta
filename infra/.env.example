# === Configuración del despliegue de GNU Health ===
# Copia este archivo a "infra/.env" y ajusta los valores.
# El archivo .env real NO se versiona (está en .gitignore).

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=gnuhealth
POSTGRES_PASSWORD=cambia_esto_en_local
POSTGRES_DB=gnuhealth
DB_HOST=db
DB_PORT=5432

# --- GNU Health ---
GNUHEALTH_PORT=8000
# Idioma de la interfaz. GNU Health trae: es (genérico) y es_419 (América Latina).
# Para México usamos es_419. NO existe es_MX (cargaría traducciones vacías).
GNUHEALTH_LANG=es_419
# Contraseña del usuario administrador (admin). CAMBIAR fuera del entorno local.
ADMIN_PASSWORD=cambia_esto_en_local
# Correo del administrador (lo pide GNU Health al crear la base; se fija sin interacción).
ADMIN_EMAIL=admin@localhost

# --- Opciones (activables por configuración) ---
# Cargar pacientes de demostración ficticios (idempotente). Apagado por defecto.
LOAD_DEMO_DATA=false

# Servicios OPCIONALES y EXPERIMENTALES (apagados por defecto). Se encienden listando
# su perfil aquí. Ejemplos:  COMPOSE_PROFILES=fhir   |   COMPOSE_PROFILES=fhir,thalamus
#   - fhir     : servidor FHIR de solo lectura (beta; ver docs/despliegue-vps.md).
#   - thalamus : hub REST de Federación (requiere MongoDB; ver docs/despliegue-vps.md).
COMPOSE_PROFILES=
FHIR_PORT=8080
THALAMUS_PORT=8443

# --- Asistente de lenguaje (Feature C, servicio ai-service, perfil "ia") ---
# La llave NUNCA se versiona. El servicio es ciego a la identidad (recibe payloads seudonimizados).
# Cliente AGNÓSTICO: cambiar de proveedor = cambiar estas variables, sin tocar código.
#   - Groq (capa gratuita, OpenAI-compatible): style=openai, base_url de abajo, modelo llama-3.1-8b-instant.
#   - Anthropic/Claude: style=anthropic, base_url=https://api.anthropic.com/v1, modelo claude-opus-4-8.
#   - opencode Zen (Kimi): style=openai, base_url=https://opencode.ai/zen/v1, modelo kimi-k2.6.
AI_PROVIDER_STYLE=openai
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_TIMEOUT=30
AI_DRY_RUN=true
AI_PORT=8090
# URL del ai-service que usa el módulo de GNU Health (red interna de compose):
AI_SERVICE_URL=http://ai-service:8080
